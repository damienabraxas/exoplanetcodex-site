{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "updated",
    "science_base",
    "methodology",
    "sources",
    "products",
    "targets",
    "elements"
  ],
  "properties": {
    "schema": {
      "const": "codex.product_roadmap/1"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "science_base": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "methodology": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "sha256"
        ],
        "properties": {
          "url": {
            "type": "string",
            "pattern": "^(https://[^\\s]+|/(?!/)[^\\s]*)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "display_order",
          "status",
          "stage",
          "validation",
          "updated",
          "issues",
          "milestones",
          "gate",
          "dependencies",
          "credits",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "display_order": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "planned",
              "discovery",
              "in_development",
              "in_review",
              "independently_validated",
              "released"
            ]
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "validation": {
            "enum": [
              "not_assessed",
              "hold",
              "independently_validated",
              "released"
            ]
          },
          "updated": {
            "type": "string",
            "format": "date"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^RYA-\\d+$"
            }
          },
          "milestones": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "title",
                "summary",
                "status",
                "validation",
                "gate",
                "issues",
                "evidence",
                "dependencies"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "planned",
                    "discovery",
                    "in_development",
                    "in_review",
                    "independently_validated",
                    "released"
                  ]
                },
                "validation": {
                  "enum": [
                    "not_assessed",
                    "hold",
                    "independently_validated",
                    "released"
                  ]
                },
                "gate": {
                  "type": "string",
                  "minLength": 1
                },
                "issues": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^RYA-\\d+$"
                  }
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "label",
                      "url",
                      "kind",
                      "date"
                    ],
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "url": {
                        "type": "string",
                        "pattern": "^(https://[^\\s]+|/(?!/)[^\\s]*)$"
                      },
                      "kind": {
                        "enum": [
                          "merged",
                          "review",
                          "scope"
                        ]
                      },
                      "date": {
                        "type": "string",
                        "format": "date"
                      }
                    }
                  }
                },
                "dependencies": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                  }
                }
              }
            }
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "credits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url",
                "kind",
                "date"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "url": {
                  "type": "string",
                  "pattern": "^(https://[^\\s]+|/(?!/)[^\\s]*)$"
                },
                "kind": {
                  "enum": [
                    "merged",
                    "review",
                    "scope"
                  ]
                },
                "date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "system_name",
          "star_params_key",
          "role",
          "run_order",
          "pipeline_status",
          "website_slug"
        ],
        "properties": {
          "system_name": {
            "type": "string"
          },
          "star_params_key": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "run_order": {
            "type": "string"
          },
          "pipeline_status": {
            "type": "string"
          },
          "website_slug": {
            "type": "string"
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
